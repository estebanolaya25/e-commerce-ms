    "PostgresConnectionString": "Host=localhost;Port=5432;Database=ecommerce_catalog;Username=catalog_app;Password=REEMPLAZAR",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=2000,syncTimeout=2000"
