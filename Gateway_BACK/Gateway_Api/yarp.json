{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/{**resto}"
        }
      },
      "auth-usuarios": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "administracion",
        "Match": {
          "Path": "/api/auth/usuarios/{**resto}"
        }
      },
      "auth-roles": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "administracion",
        "Match": {
          "Path": "/api/auth/roles"
        }
      },
      "catalogo": {
        "ClusterId": "catalogo",
        "RateLimiterPolicy": "catalogo",
        "Match": {
          "Path": "/api/catalogo/{**resto}"
        }
      },
      "inventario": {
        "ClusterId": "inventario",
        "RateLimiterPolicy": "inventario",
        "Match": {
          "Path": "/api/inventario/{**resto}"
        }
      },
      "carrito": {
        "ClusterId": "carrito",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "carrito",
        "Match": {
          "Path": "/api/carrito/{**resto}"
        }
      },
      "carrito-swagger": {
        "ClusterId": "carrito",
        "Match": {
          "Path": "/api/carrito/swagger/{**resto}"
