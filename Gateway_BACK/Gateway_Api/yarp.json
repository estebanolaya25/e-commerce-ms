        "ClusterId": "pedidos",
        "Match": {
          "Path": "/api/pedidos/swagger/{**resto}"
        }
      },
      "pagos": {
        "ClusterId": "pagos",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "pagos",
        "Match": {
          "Path": "/api/pagos/{**resto}"
        }
      },
      "pagos-swagger": {
        "ClusterId": "pagos",
        "Match": {
          "Path": "/api/pagos/swagger/{**resto}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "auth1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "catalogo": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "catalogo1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "inventario": {
        "HealthCheck": {
