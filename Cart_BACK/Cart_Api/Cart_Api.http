@Gateway = http://localhost:5100
@Token = PEGAR_ACCESS_TOKEN_DE_CUALQUIER_USUARIO

GET {{Gateway}}/api/carrito
Authorization: Bearer {{Token}}

###
POST {{Gateway}}/api/carrito/items
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "sku": "P00005-AZUL-M",
  "cantidad": 2
}

###
PUT {{Gateway}}/api/carrito/items/P00005-AZUL-M
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "cantidad": 1
}

###
DELETE {{Gateway}}/api/carrito/items/P00005-AZUL-M
Authorization: Bearer {{Token}}

###
DELETE {{Gateway}}/api/carrito
Authorization: Bearer {{Token}}

